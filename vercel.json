{
  "redirects": [
    { "source": "/login.html", "destination": "/admin/login.html", "permanent": false },
    { "source": "/register.html", "destination": "/", "permanent": false },
    { "source": "/account.html", "destination": "/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index?path=:path*" },
    { "source": "/checkout.html", "destination": "/client/checkout.html" },
    { "source": "/cart.html", "destination": "/client/cart.html" },
    { "source": "/product.html", "destination": "/client/product.html" },
    { "source": "/css/:path*", "destination": "/client/css/:path*" },
    { "source": "/js/:path*", "destination": "/client/js/:path*" }
  ]
}
